# Convex deployment URL (public prod URL, e.g. https://xxxxx.convex.cloud)
CONVEX_URL=

# Shared secret between the WhatsApp bot and this MCP server.
# Every request to /mcp must include: Authorization: Bearer <MCP_CLIENT_SECRET>
MCP_CLIENT_SECRET=

# Google Maps API key (Places + Geocoding). Required at startup.
# NOTE: the geocoding tools run as Convex actions, so this SAME key must also be
# set in the Convex deployment: `npx convex env set GOOGLE_API_KEY <key>`
GOOGLE_API_KEY=

# OAuth via Clerk — OPTIONAL. Set BOTH to let interactive MCP clients (Claude
# Desktop, Cursor, …) sign in with a Clerk OAuth token instead of the shared
# secret above; headless callers keep using the secret either way. Leave both
# empty and OAuth is simply off. Use the PRODUCTION Clerk instance keys, and
# enable "Dynamic client registration" under OAuth applications in the Clerk
# dashboard or clients cannot register themselves.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# Port to listen on (default 3000)
PORT=3000

# Allowed origins for CORS (comma-separated). Leave empty to disallow browser callers.
ALLOWED_ORIGINS=
